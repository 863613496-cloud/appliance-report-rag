# ==========================================================================
# 环境变量模板
#
# 用法：复制本文件为 .env，再填入自己的真实值。
#   cp .env.example .env        （Windows Git Bash）
#   copy .env.example .env      （Windows CMD）
#
# 重要：
#   1. 本文件不包含任何真实密钥，所有值均为空占位符，可安全提交到 Git。
#   2. .env 已在 .gitignore 中，切勿将真实密钥提交或截图到作业报告中。
#   3. 当前项目仍处于骨架阶段，尚未调用任何模型接口，因此暂时无需填写。
# ==========================================================================

# ---------- 大模型：生成回答 ----------
# 本项目不绑定具体厂商，按你所选的服务填写即可。
# 若使用 Claude（官方 Anthropic SDK），把 provider 填 anthropic：
#   模型 ID 示例：claude-opus-5-5（当前默认）/ claude-sonnet-5-5 / claude-haiku-5-5
#   接口地址留空即可，SDK 默认走官方端点。
# 若使用 OpenAI 兼容接口的厂商（DeepSeek / 通义千问 / Kimi / 智谱等），
#   provider 填 openai_compatible，并填写对应的 BASE_URL 与模型名。
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0.2

# ---------- 向量检索 / Embedding ----------
# 本地开源模型（如 BGE 系列）通常无需密钥，只填模型名即可。
# 若使用在线 Embedding 服务，再填写 EMBEDDING_API_KEY。
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---------- 检索与切分参数 ----------
TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---------- 数据下载 ----------
# 巨潮资讯网等公开披露平台一般无需密钥；下载间隔用于礼貌访问，勿设为 0。
DOWNLOAD_DELAY_SECONDS=3
HTTP_USER_AGENT=

# ---------- 应用 ----------
APP_PORT=8501
LOG_LEVEL=INFO
